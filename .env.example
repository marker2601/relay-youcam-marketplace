# Relay application
APP_TIME_ZONE=America/Chicago
DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL (local Docker examples only)
DATABASE_URL=postgresql://relay:relay_local@localhost:54329/relay
TEST_DATABASE_URL=postgresql://relay:relay_local@localhost:54329/relay_test

# Private S3-compatible object storage (local MinIO examples only)
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=relay-media
S3_ACCESS_KEY_ID=relay_local
S3_SECRET_ACCESS_KEY=replace-with-local-or-managed-storage-secret
S3_FORCE_PATH_STYLE=true

# YouCam Clothes v3. Keep fake mode for automated tests.
YOUCAM_MODE=fake
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_API_KEY=
